cabal-version: 3.0

name:           sc-mini
version:        1.0
build-type:     Simple

library
  exposed-modules:
      Data
      DataIO
      DataUtil
      Deforester
      Demonstration
      Driving
      Folding
      Generator
      Interpreter
      Prototype
      Supercompiler
      TreeInterpreter
      Bedrock
      LLMSupercompiler
      Types
      LeanEmbed
      LeanCheck
      LeanProver
  hs-source-dirs:
      src
  build-depends:
      base >= 4.13 && < 5,
      template-haskell,
      aeson,
      bytestring,
      http-client,
      http-client-tls,
      text,
      time,
      cryptohash-sha256,
      base16-bytestring,
      case-insensitive,
      http-types,
      directory,
      containers,
      filepath,
      process,
      temporary,
  default-language: Haskell2010

executable llm-bench
  main-is:          Main.hs
  hs-source-dirs:   bench
  build-depends:
      base >= 4.13 && < 5,
      sc-mini,
      directory,
  default-language: Haskell2010
  ghc-options:      -threaded

executable llm-perf
  main-is:          Perf.hs
  hs-source-dirs:   bench
  build-depends:
      base >= 4.13 && < 5,
      sc-mini,
  default-language: Haskell2010
  ghc-options:      -threaded
